{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "typography": {
    "fontFamilies": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    },
    "lineHeights": {
      "tight": "16px",
      "snug": "20px",
      "normal": "24px",
      "relaxed": "28px",
      "loose": "32px",
      "heading": "40px"
    },
    "letterSpacing": {
      "tighter": "-0.05em",
      "tight": "-0.025em",
      "normal": "0em",
      "wide": "0.025em",
      "wider": "0.05em"
    }
  }
}
