{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": [
    "specs/**/*",
    "guardrails/**/*",
    "evals/**/*",
    ".observability/**/*",
    ".debug/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
